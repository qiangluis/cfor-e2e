# 复制为 scripts/e2e/.env 后填入真实值；.env 已加入 .gitignore，切勿提交
# 运行目标：online（默认，https://jixu-ai.com）或 local（本机前后端）
CFOR_TARGET=online

# online 目标：站点根地址；API 前缀默认 /admin-api（与前端 public/config.json 的 projectUrl 一致）
CFOR_BASE_URL=https://jixu-ai.com
CFOR_API_PREFIX=/admin-api

# local 目标会用到下面两项（online 目标忽略）
CFOR_WEB_URL=http://127.0.0.1:9160
CFOR_LOCAL_API_URL=http://127.0.0.1:48083/admin-api

# 登录身份（租户名 / 用户名 / 密码）。密码只从环境或 .env 读取，禁止写进代码和报告
CFOR_TENANT=福奇科技
CFOR_USER=admin
CFOR_PASS=

# 浏览器：true=无头，false=有头调试
CFOR_HEADLESS=true
# 本机 Chrome 路径（playwright-core 需要显式指定；Mac 例：/Applications/Google Chrome.app/Contents/MacOS/Google Chrome）
CFOR_CHROME_PATH=
# 证据输出目录
CFOR_EVIDENCE_DIR=/tmp/cfor-e2e
