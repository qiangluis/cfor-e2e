# Copy to scripts/e2e/config/local.env. Never commit the local file.
CFOR_TARGET=local
CFOR_WEB_BASE=http://127.0.0.1:9151
CFOR_API_BASE=http://127.0.0.1:48083
CFOR_API_HEALTH_URL=http://127.0.0.1:48083/actuator/health
CFOR_TENANT_ID=1
CFOR_TENANT_NAME=CFOR 标准平台
CFOR_USERNAME=admin
CFOR_PASSWORD=
# 请购 BPM 使用真实采购负责人账号；密码仅配置在本地 local.env，不提交
CFOR_PURCHASE_APPROVER_USERNAME=purmgr01
CFOR_PURCHASE_APPROVER_PASSWORD=
CFOR_FINANCE_APPROVER_USERNAME=finrvw01
CFOR_FINANCE_APPROVER_PASSWORD=
CFOR_FINAL_APPROVER_USERNAME=opsmgr01
CFOR_FINAL_APPROVER_PASSWORD=
# WMS 调拨/借用 BPM 的实际仓储负责人账号；密码仅配置在本地 local.env，不提交
CFOR_WAREHOUSE_APPROVER_USERNAME=whmgr01
CFOR_WAREHOUSE_APPROVER_PASSWORD=
# WMS 调拨/借用 BPM 的库存复核终审账号；密码仅配置在本地 local.env，不提交
CFOR_WAREHOUSE_FINAL_APPROVER_USERNAME=invmgr01
CFOR_WAREHOUSE_FINAL_APPROVER_PASSWORD=
CFOR_FMS_ACCOUNT_SET_ID=
CFOR_REGISTER_TENANT_NAME=CFOR 标准平台
# Registration requires a real mailbox, email code and platform approval.
# CFOR_REGISTER_CONTACT_NAME=
# CFOR_REGISTER_EMAIL=
# CFOR_REGISTER_PASSWORD=
# CFOR_REGISTER_EMAIL_CODE=
CFOR_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CFOR_E2E_HEADLESS=true
CFOR_E2E_OUT=/tmp/cfor-e2e
CFOR_E2E_REQUEST_TIMEOUT_MS=30000
CFOR_E2E_BROWSER_TIMEOUT_MS=60000
# API-encrypted standalone tools must match the target environment configuration.
# Never commit keys in this example.
# CFOR_API_ENCRYPT_REQUEST_KEY=
# CFOR_API_ENCRYPT_RESPONSE_KEY=

# Required for write-side acceptance such as PROC-014. SQL is always read-only.
# Do not commit database passwords.
# CFOR_DB_HOST=127.0.0.1
# CFOR_DB_PORT=3306
# CFOR_DB_NAME=cfor_admin_standard
# CFOR_DB_USER=readonly
# CFOR_DB_PASSWORD=
